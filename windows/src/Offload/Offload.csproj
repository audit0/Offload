<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Offload</RootNamespace>
    <AssemblyName>Offload</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Offload.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Offload.Core/Offload.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Offload.ico" />
  </ItemGroup>
  <!-- День выхода версии (scripts\build.ps1): ключ Offload Pro открывает версии, вышедшие до конца его обновлений. -->
  <ItemGroup Condition="'$(OffloadReleaseDate)' != ''">
    <AssemblyMetadata Include="OffloadReleaseDate" Value="$(OffloadReleaseDate)" />
  </ItemGroup>
</Project>
