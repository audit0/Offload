<UserControl x:Class="Offload.CleanupQuestionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload">
    <!-- Один вопрос: что найдено, что будет по «да», и две кнопки. После ответа — что сделано. -->
    <local:Card x:Name="Root">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:IconTile x:Name="Tile" Size="40" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleText" Style="{StaticResource Headline}" VerticalAlignment="Bottom" Margin="0,0,8,2" />
                        <TextBlock x:Name="AmountText" Grid.Column="1" Style="{StaticResource Display}" FontSize="20" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <TextBlock x:Name="BodyText" Style="{StaticResource Callout}" Margin="0,4,0,0" />
                    <ItemsControl x:Name="Notes" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Сейф для вопроса «в сейф»: есть ли он, открыт ли и поместится ли. -->
                    <StackPanel x:Name="SafeLine" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="SafeGlyph" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="SafeText" Style="{StaticResource Caption}" />
                        <Button x:Name="SafeLink" Style="{StaticResource LinkButton}" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                VerticalAlignment="Top" Click="SafeLink_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Ждёт ответа. -->
            <Grid x:Name="AskingPanel" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HintRow" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Ink}" Margin="0,1,6,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Foreground="{StaticResource Ink}" />
                </StackPanel>
                <Button x:Name="NoButton" Grid.Column="1" Style="{StaticResource LargeButton}" Margin="0,0,10,0" Click="No_Click" />
                <Button x:Name="YesButton" Grid.Column="2" Style="{StaticResource LargeProminentButton}" Click="Yes_Click" />
            </Grid>

            <!-- В очереди. -->
            <Grid x:Name="QueuedPanel" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Style="{StaticResource Spinner}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="В очереди — начну, как только закончу предыдущее" Style="{StaticResource Callout}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Отменить" Click="Reconsider_Click" />
            </Grid>

            <!-- Выполняется. -->
            <StackPanel x:Name="RunningPanel" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RunCount" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" />
                    <TextBlock x:Name="RunItem" Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="RunPhase" Grid.Column="2" Style="{StaticResource Callout}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Grid.Column="3" Content="Остановить" Click="Stop_Click" />
                </Grid>
                <ProgressBar x:Name="RunBar" Maximum="1" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Сделано. -->
            <StackPanel x:Name="DonePanel" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DoneGlyph" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,8,0"
                               VerticalAlignment="Top" />
                    <TextBlock x:Name="DoneText" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RestoreButton" Grid.Column="2" Click="Restore_Click" Margin="0,0,8,0"
                            ToolTip="Вернуть из Корзины на прежние места — и больше не предлагать">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ink}" Margin="0,0,6,0" />
                            <TextBlock Text="Вернуть" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenBackupButton" Grid.Column="3" Content="Открыть «Бэкап»" Click="OpenBackup_Click" />
                </Grid>
                <local:NoticeView x:Name="Problems" Kind="Warning" Margin="0,8,0,0" />
            </StackPanel>

            <!-- «Не сейчас». -->
            <Grid x:Name="DeclinedPanel" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Не трогаю. Спрошу в следующий раз." Style="{StaticResource Callout}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Передумал" Style="{StaticResource LinkButton}" FontSize="12.5" FontWeight="SemiBold" Click="Reconsider_Click" />
            </Grid>

            <!-- «Что именно» — по желанию, свёрнуто: для ответа хватает строки выше. -->
            <StackPanel x:Name="DetailsPanel" Margin="0,12,0,0">
                <Button x:Name="DetailsToggle" Style="{StaticResource LinkButton}" FontSize="12.5" Click="DetailsToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetailsChevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,1,8,0" />
                        <TextBlock x:Name="DetailsTitle" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="DetailsList" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </local:Card>
</UserControl>
