<UserControl x:Class="Offload.NewPasswordFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload">
    <!-- Новый пароль дважды и шкала. Годится для создания сейфа и смены пароля. -->
    <StackPanel>
        <PasswordBox x:Name="First" Tag="Новый пароль" PasswordChanged="Changed" />
        <PasswordBox x:Name="Second" Tag="Ещё раз" PasswordChanged="Changed" Margin="0,8,0,0" />
        <local:PasswordStrengthView x:Name="Strength" Margin="0,8,0,0" />
        <StackPanel x:Name="Mismatch" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,0,6,0" />
            <TextBlock Text="Пароли не совпадают." Style="{StaticResource Caption}" Foreground="{StaticResource Bad}" />
        </StackPanel>
    </StackPanel>
</UserControl>
