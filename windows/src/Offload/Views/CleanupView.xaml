<UserControl x:Class="Offload.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload">
    <!-- Разбор компьютера: «Начать» → вопросы → ответы. Никаких флажков и папок: на каждый вопрос — «да» или «не сейчас»,
         и сделанное видно сразу у вопроса. -->
    <UserControl.Resources>
        <!-- Большая круглая кнопка, с которой начинается разбор. -->
        <Style x:Key="ScanButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="128" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Fill">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#111111" Offset="0" />
                                        <GradientStop Color="#B8111111" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#111111" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEA99;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Fill" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="36" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#111111" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Место, где ищет разбор: капсула со значком. -->
        <Style x:Key="PlaceChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="#0F000000" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Padding="32" MaxWidth="1044">
            <StackPanel>
                <local:NoticeView x:Name="StoreNotice" Kind="Warning" Margin="0,0,0,28" Visibility="Collapsed" />

                <!-- Начало. -->
                <StackPanel x:Name="StartPanel">
                    <Border CornerRadius="22" Padding="24" BorderThickness="1" BorderBrush="#40111111" Margin="0,0,0,28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#24111111" Offset="0" />
                                <GradientStop Color="#08111111" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Разобрать компьютер" Style="{StaticResource Display}" FontSize="30" />
                                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                                           Text="Найду, что занимает место зря, и спрошу про каждое: удалить или нет. Выбирать файлы и ходить по папкам не нужно — только отвечать «да» или «не сейчас». Без вашего «да» ничего не трогаю." />
                                <WrapPanel x:Name="Places" Margin="0,12,0,-6" />
                            </StackPanel>
                            <Button x:Name="StartButton" Grid.Column="1" Content="Начать" Style="{StaticResource ScanButton}" Margin="24,0,0,0"
                                    VerticalAlignment="Center" Click="Start_Click" IsVisibleChanged="StartButton_IsVisibleChanged" />
                        </Grid>
                    </Border>

                    <local:CardSection x:Name="LastRunSection" Margin="0,0,0,28">
                        <UniformGrid Columns="3" Margin="18">
                            <StackPanel>
                                <TextBlock x:Name="LastTrashed" Style="{StaticResource Display}" FontSize="20" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="удалено" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="LastMoved" Style="{StaticResource Display}" FontSize="20" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="убрано в сейф" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="LastAdded" Style="{StaticResource Display}" FontSize="20" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="добавлено в бэкап" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </local:CardSection>

                    <local:CardSection Header="О чём спрошу" Margin="0,0,0,28"
                                       Footer="Удаляемое уходит в Корзину — вернуть можно одной кнопкой у своего вопроса, а в конце можно удалить это из Корзины насовсем. Образы Docker удаляет сам Docker, он скачает их снова. В сейф — со сверкой каждого файла; вернуть можно в «Перенесённом».">
                        <StackPanel x:Name="Legend" />
                    </local:CardSection>

                    <!-- Чему Offload научился на решениях человека — и кнопка, чтобы всё это забыть. -->
                    <local:CardSection x:Name="LearnedSection" Header="Чему научился" Margin="0,0,0,28"
                                       Footer="Учусь только на этом компьютере и только на ваших ответах. Что вы вернули из Корзины, больше не предлагаю; похожее на то, что вы обычно убираете в сейф, добавляю в вопрос о сейфе. Сам ничего не делаю — только спрашиваю.">
                        <StackPanel x:Name="Learned" />
                    </local:CardSection>

                    <!-- То, что человек просил больше не предлагать, — с возможностью вернуть. -->
                    <local:CardSection x:Name="IgnoredSection" Margin="0,0,0,28"
                                       Footer="Сюда попадает то, что вы попросили больше не предлагать: «Что именно» у вопроса → правый щелчок по строке → «Не предлагать больше». Папка — вместе со всем, что внутри.">
                        <StackPanel x:Name="IgnoredList" />
                    </local:CardSection>
                </StackPanel>

                <!-- Поиск. -->
                <StackPanel x:Name="ScanPanel">
                    <local:Card Margin="0,0,0,28">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Background="#24111111">
                                    <TextBlock Text="&#xEA99;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource Ink}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScanTitle" Style="{StaticResource Display}" FontSize="19" />
                                    <TextBlock x:Name="ScanCurrent" Style="{StaticResource Callout}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="ScanCount" Grid.Column="2" Style="{StaticResource Callout}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" />
                                <Button Grid.Column="3" Content="Отменить" Click="CancelScan_Click" />
                            </Grid>
                            <ProgressBar x:Name="ScanBar" Maximum="1" Margin="0,16,0,0" />
                        </StackPanel>
                    </local:Card>
                    <UniformGrid x:Name="ScanTilesTop" Columns="2" Margin="-6,0,-6,12" />
                    <UniformGrid x:Name="ScanTilesBottom" Columns="3" Margin="-6,0,-6,28" />
                </StackPanel>

                <!-- Вопросы. -->
                <StackPanel x:Name="ReviewPanel">
                    <local:Card x:Name="NothingCard" Margin="0,0,0,28">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC61;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Ink}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Body}"
                                           Text="Спрашивать не о чем: мусора и лишнего нет, а всё крупное либо используется, либо уже на своём месте." />
                            </StackPanel>
                            <Button Content="Готово" Margin="0,12,0,0" Click="Done_Click" />
                        </StackPanel>
                    </local:Card>

                    <!-- Сколько можно освободить и «Разрешить всё» — или, когда ответили на всё, сколько освободилось. -->
                    <local:Card x:Name="SummaryCard" Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="SummaryCaption" Style="{StaticResource Callout}" />
                                <TextBlock x:Name="SummaryValue" Style="{StaticResource Display}" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" />
                                <TextBlock x:Name="SummaryLine" Style="{StaticResource Callout}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Без Enter: одно нажатие отвечало бы «да» на все вопросы сразу, включая безвозвратную очистку Docker. -->
                                <Button x:Name="AllowAllButton" Style="{StaticResource LargeProminentButton}" MinWidth="150" HorizontalAlignment="Right"
                                        Click="AllowAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="AllowAllText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelReviewButton" Content="Отмена" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                                        HorizontalAlignment="Right" Margin="0,10,4,0" Click="Cancel_Click" />
                            </StackPanel>
                        </Grid>
                    </local:Card>

                    <!-- Docker стоит, но не запущен: что в нём можно убрать, узнать нельзя — сказать, как это исправить. -->
                    <local:Card x:Name="DockerIdleCard" Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:IconTile Glyph="&#xE7B8;" Tone="Neutral" Size="40" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                <TextBlock Text="Docker не запущен" Style="{StaticResource Headline}" />
                                <TextBlock x:Name="DockerIdleText" Style="{StaticResource Callout}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="LaunchDockerButton" Grid.Column="2" Content="Запустить Docker" VerticalAlignment="Top" Click="LaunchDocker_Click" />
                        </Grid>
                    </local:Card>

                    <StackPanel x:Name="Questions" />

                    <local:NoticeView x:Name="IgnoreNotice" Kind="Warning" Margin="0,0,0,28" />

                    <!-- Удалённое этим разбором лежит в Корзине: удалить насовсем, чтобы место освободилось сейчас? -->
                    <local:Card x:Name="TrashCard" Margin="0,0,0,28">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:IconTile Glyph="&#xE74D;" Tone="Danger" Size="40" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                    <TextBlock Text="Удалить из Корзины насовсем?" Style="{StaticResource Headline}" />
                                    <TextBlock x:Name="TrashText" Style="{StaticResource Callout}" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TrashBytes" Grid.Column="2" Style="{StaticResource Display}" FontSize="20" VerticalAlignment="Top"
                                           Typography.NumeralAlignment="Tabular" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="FinishingRow" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource Spinner}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="FinishingText" Style="{StaticResource Callout}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="EraseButton" Grid.Column="1" Click="Erase_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Bad}" Margin="0,0,6,0" />
                                        <TextBlock Text="Удалить насовсем…" Foreground="{StaticResource Bad}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </local:Card>
                    <local:NoticeView x:Name="ErasedNotice" Margin="0,0,0,28" />
                    <local:NoticeView x:Name="TrashProblemsNotice" Margin="0,0,0,28" />

                    <StackPanel x:Name="FinalButtons" Orientation="Horizontal" Margin="0,0,0,28">
                        <Button Content="Готово" Margin="0,0,8,0" Click="Done_Click" />
                        <Button Content="Разобрать ещё раз" Click="Again_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
