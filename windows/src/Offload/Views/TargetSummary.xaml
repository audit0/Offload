<UserControl x:Class="Offload.TargetSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload">
    <!-- Куда пойдут данные — с замком. Главное, что человек должен видеть перед любым переносом: зашифровано это будет или нет. -->
    <local:Card x:Name="Plate" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:IconTile x:Name="Tile" Size="30" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Style="{StaticResource Body}" FontWeight="Medium" />
                <TextBlock x:Name="Detail" Style="{StaticResource Caption}" />
            </StackPanel>
        </Grid>
    </local:Card>
</UserControl>
