<UserControl x:Class="Offload.HistoryRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload"
             Background="Transparent">
    <!-- Запись журнала: что это было, где лежало, когда и куда унесено, и можно ли вернуть сейчас. -->
    <Grid Margin="0,10,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <local:IconTile x:Name="Tile" Size="32" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" FontWeight="Medium" FontSize="13.5" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            <TextBlock x:Name="NoteText" Style="{StaticResource Caption}" Foreground="{StaticResource Ink}" Margin="0,2,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="MacText" Style="{StaticResource Caption}" Foreground="{StaticResource Ink}" Margin="0,2,0,0" Visibility="Collapsed"
                       Text="Перенесено на Mac — вернуть можно только в OffLoadAI для Mac. Архив лежит на диске, его можно скопировать и вручную." />
        </StackPanel>
        <!-- Лупа видна под мышью: в каждой строке сразу она только шумела бы. -->
        <Button x:Name="RevealButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Показать на диске"
                Opacity="0" Margin="0,0,8,0" VerticalAlignment="Center" Click="Reveal_Click" />
        <Grid Grid.Column="3" VerticalAlignment="Center">
            <local:StatusPill x:Name="StatePill" Visibility="Collapsed" />
            <Button x:Name="RestoreButton" Content="Вернуть…" Visibility="Collapsed" Click="Restore_Click" />
        </Grid>
    </Grid>
</UserControl>
