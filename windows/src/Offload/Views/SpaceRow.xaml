<UserControl x:Class="Offload.SpaceRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload"
             Margin="0,0,0,2">
    <!-- Строка раздела «Освободить место»: что это, сколько весит рядом с самым большим, что решили правила, что можно сделать. -->
    <Border x:Name="Back" CornerRadius="8" Padding="10,8" Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <local:IconTile x:Name="Tile" Size="32" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NameText" FontWeight="Medium" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <local:StatusPill x:Name="AccessPill" Tone="Caution" Glyph="&#xE7BA;" Margin="6,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <local:CapacityBar x:Name="Bar" BarHeight="5" MaxWidth="320" HorizontalAlignment="Stretch" Margin="0,5,0,0" />
                <TextBlock x:Name="NoteText" Style="{StaticResource Caption}" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SizeText" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Right" />
                <ProgressBar x:Name="SizeSpinner" Style="{StaticResource Spinner}" HorizontalAlignment="Right" Visibility="Collapsed" />
                <TextBlock x:Name="DateText" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0" />
            </StackPanel>
            <local:StatusPill x:Name="VerdictPill" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Лупа видна под мышью: в каждой строке сразу она только шумела бы. -->
                <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Показать в Проводнике" Opacity="0"
                        Margin="0,0,6,0" Click="Reveal_Click" />
                <Button x:Name="ActionButton" Style="{StaticResource SmallButton}" Click="Action_Click" />
                <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Открыть" Margin="6,0,0,0"
                        Click="Open_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
