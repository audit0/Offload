<UserControl x:Class="Offload.CloudRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Offload">
    <UserControl.Resources>
        <local:VisibleConverter x:Key="Visible" />
        <Style x:Key="ButtonGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Строка-кнопка во всю ширину: выбор хранилища, переход в папку. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="8">
                            <ContentPresenter RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#0A000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Back" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Файл или папка снимка: слева — открыть папку, справа — восстановить. -->
        <DataTemplate x:Key="EntryRow">
            <StackPanel>
                <Separator Style="{StaticResource RowDivider}" />
                <Grid Margin="14,6,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="Entry_Click" IsEnabled="{Binding CanOpen}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:IconTile Glyph="{Binding Glyph}" Tone="{Binding Tone}" Size="26" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Entry.Name}" Style="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0"
                                       Visibility="{Binding Entry.IsDirectory, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Восстановить" Margin="8,0,0,0" Tag="{Binding}"
                            IsEnabled="{Binding CanRestore}" Click="Restore_Click" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel x:Name="Root">

        <!-- 1. Хранилище -->
        <local:CardSection Header="Хранилище" Number="1"
                           Footer="Бэкапы restic из iCloud Drive — например, копия внешнего диска. Offload только читает хранилище и ничего в нём не меняет, а пароль держит в памяти, пока хранилище открыто: сон и блокировка экрана его стирают.">
            <StackPanel>
                <StackPanel x:Name="ResticMissing">
                    <StackPanel Margin="18">
                        <local:NoticeView x:Name="ResticNotice" Kind="Warning" />
                        <Button Content="Проверить снова" Margin="0,10,0,0" Click="Discover_Click" />
                    </StackPanel>
                    <Separator Style="{StaticResource RowDivider}" />
                </StackPanel>
                <StackPanel x:Name="SearchingRow">
                    <StackPanel Orientation="Horizontal" Margin="14,10">
                        <ProgressBar Style="{StaticResource Spinner}" />
                        <TextBlock Text="Ищу бэкапы в iCloud Drive…" Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Separator Style="{StaticResource RowDivider}" />
                </StackPanel>
                <StackPanel x:Name="NothingFound">
                    <TextBlock Text="В iCloud Drive бэкапов restic не нашлось. Если хранилище лежит в другом месте, выберите его папку."
                               Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="14,10" />
                    <Separator Style="{StaticResource RowDivider}" />
                </StackPanel>
                <ItemsControl x:Name="RepositoryList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="Repository_Click" IsEnabled="{Binding Enabled}" Margin="4,2">
                                    <Grid Margin="10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:IconTile Glyph="&#xE753;" Tone="{Binding Tone}" Size="26" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Repository.Name}" Style="{StaticResource Body}" FontWeight="{Binding Weight}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Repository.Path}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Ink}"
                                                   Visibility="{Binding Selected, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Button>
                                <Separator Style="{StaticResource RowDivider}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ChooseRepositoryButton" Style="{StaticResource LinkButton}" Margin="14,10" Click="ChooseRepository_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource ButtonGlyph}" />
                        <TextBlock Text="Выбрать папку хранилища…" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="PasswordBlock">
                    <Separator Style="{StaticResource RowDivider}" />
                    <StackPanel Margin="18">
                        <Grid x:Name="UnlockedRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" Foreground="{StaticResource Ink}" Margin="0,0,8,0" />
                            <TextBlock x:Name="UnlockedText" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <Button x:Name="LockButton" Grid.Column="2" Content="Закрыть" Click="Lock_Click" />
                        </Grid>
                        <StackPanel x:Name="LockedBlock">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                <PasswordBox x:Name="Password" Grid.Column="1" Tag="Пароль хранилища" KeyDown="Password_KeyDown" PasswordChanged="Password_Changed" />
                                <ProgressBar x:Name="UnlockSpinner" Grid.Column="2" Style="{StaticResource Spinner}" Margin="8,0,0,0" />
                                <Button x:Name="UnlockButton" Grid.Column="2" Content="Открыть" Style="{StaticResource ProminentButton}" Margin="8,0,0,0"
                                        IsEnabled="False" Click="Unlock_Click" />
                            </Grid>
                            <StackPanel x:Name="FileLinks" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="RememberedFileButton" Style="{StaticResource LinkButton}" FontSize="12.5" Margin="0,0,12,0" Click="RememberedFile_Click">
                                    <TextBlock x:Name="RememberedFileText" TextDecorations="Underline" />
                                </Button>
                                <Button Style="{StaticResource LinkButton}" FontSize="12.5" Click="PasswordFile_Click">
                                    <TextBlock Text="Пароль из файла…" TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Grid x:Name="ErrorRow" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Top" />
                            <TextBox x:Name="ErrorText" Grid.Column="1" Style="{StaticResource SelectableText}" Foreground="{StaticResource Bad}" FontSize="11.5" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </local:CardSection>

        <StackPanel x:Name="UnlockedSections">
            <!-- 2. Снимок -->
            <local:CardSection Header="Снимок" Number="2" Margin="0,28,0,0">
                <StackPanel Margin="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Снимок" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="SnapshotPicker" Grid.Column="1" DisplayMemberPath="Title" SelectedValuePath="Id"
                                  SelectionChanged="SnapshotPicker_SelectionChanged" />
                    </Grid>
                    <Grid x:Name="SnapshotPathsRow" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Что в снимке" Style="{StaticResource Callout}" Margin="0,0,12,0" />
                        <TextBox x:Name="SnapshotPaths" Grid.Column="1" Style="{StaticResource SelectableText}" FontSize="12.5" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </local:CardSection>

            <!-- 3. Куда восстановить -->
            <local:CardSection Header="Куда восстановить" Number="3" Margin="0,28,0,0">
                <StackPanel Margin="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Папка" Style="{StaticResource Callout}" VerticalAlignment="Center" />
                        <TextBox x:Name="DestinationText" Grid.Column="1" Style="{StaticResource SelectableText}" TextWrapping="NoWrap" FontSize="12.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button x:Name="ChooseDestinationButton" Grid.Column="2" Content="Выбрать…" Margin="10,0,0,0" Click="ChooseDestination_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="Внутри появится новая папка «Из бэкапа …»: ничего существующего не перезаписывается. Восстановленное сверяется с бэкапом." />
                    <StackPanel x:Name="RestoringBlock" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RestoringText" Style="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="RestoringBytes" Grid.Column="1" Style="{StaticResource Body}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="12,0" />
                            <Button Grid.Column="2" Content="Остановить" Click="CancelRestore_Click" />
                        </Grid>
                        <ProgressBar x:Name="RestoreBar" Maximum="1" Margin="0,8,0,0" />
                        <TextBlock x:Name="SizingText" Text="Считаю размер…" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <local:NoticeView x:Name="WaitingNotice" Kind="Warning" Margin="0,8,0,0"
                                          Text="Жду iCloud: часть бэкапа хранится только в облаке, и iCloud её ещё не скачал. Offload попросил скачать и ждёт. Если долго ничего не меняется, проверьте в Проводнике → iCloud Drive, что синхронизация идёт, — или остановите и попробуйте позже." />
                    </StackPanel>
                    <local:NoticeView x:Name="RestoreNotice" Margin="0,12,0,0" />
                    <Button x:Name="RevealButton" Margin="0,10,0,0" Click="Reveal_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource ButtonGlyph}" />
                            <TextBlock Text="Показать в Проводнике" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </local:CardSection>

            <!-- 4. Файлы -->
            <local:CardSection Header="Файлы" Number="4" Margin="0,28,0,0">
                <StackPanel>
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                        <TextBox x:Name="QueryBox" Grid.Column="1" Tag="Найти по имени во всём снимке" KeyDown="Query_KeyDown"
                                 Text="{Binding Cloud.Query, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" Text="Найти по имени во всём снимке" Foreground="#8E8E93" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontSize="13"
                                   Visibility="{Binding Cloud.Query, Converter={StaticResource Visible}, ConverterParameter=not}" />
                        <Button x:Name="SearchButton" Grid.Column="2" Content="Найти" Margin="8,0,0,0" Click="Search_Click" />
                        <Button x:Name="ClearSearchButton" Grid.Column="3" Content="Сбросить" Margin="8,0,0,0" Click="ClearSearch_Click" />
                    </Grid>
                    <StackPanel x:Name="LoadingRow">
                        <Separator Style="{StaticResource RowDivider}" />
                        <StackPanel Orientation="Horizontal" Margin="14,10">
                            <ProgressBar Style="{StaticResource Spinner}" />
                            <TextBlock x:Name="LoadingText" Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SearchBlock">
                        <Separator Style="{StaticResource RowDivider}" />
                        <TextBlock x:Name="SearchSummary" Style="{StaticResource Callout}" Margin="14,10" />
                        <ItemsControl x:Name="SearchList" Focusable="False" ItemTemplate="{StaticResource EntryRow}" />
                    </StackPanel>

                    <StackPanel x:Name="BrowseBlock">
                        <Separator Style="{StaticResource RowDivider}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="14,10">
                            <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyFolder">
                            <Separator Style="{StaticResource RowDivider}" />
                            <TextBlock Text="Папка пуста." Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="14,10" />
                        </StackPanel>
                        <ItemsControl x:Name="EntryList" Focusable="False" ItemTemplate="{StaticResource EntryRow}" />
                        <StackPanel x:Name="MoreRow">
                            <Separator Style="{StaticResource RowDivider}" />
                            <TextBlock x:Name="MoreText" Style="{StaticResource Callout}" Margin="14,10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </local:CardSection>
        </StackPanel>
    </StackPanel>
</UserControl>
