<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Offload">

    <!-- Шаблоны своих элементов. Цвета и шрифты — те же, что у версии для Mac (см. Design.cs). -->

    <local:ToneBrushConverter x:Key="ToneBrush" />
    <local:VisibleConverter x:Key="Visible" />
    <local:ScaleConverter x:Key="Scale" />

    <SolidColorBrush x:Key="Ink" Color="#111111" />
    <SolidColorBrush x:Key="Muted" Color="#55555A" />
    <SolidColorBrush x:Key="Faint" Color="#6E6E73" />
    <SolidColorBrush x:Key="Line" Color="#D8D8DE" />
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Карточка: стеклянная пластина с бликом по кромке и мягкой тенью. -->
    <Style TargetType="{x:Type local:Card}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="#B8FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Card}">
                    <Grid>
                        <Border CornerRadius="18" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.07" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="18" BorderThickness="0.8" BorderBrush="{StaticResource GlassEdge}" />
                        <Border CornerRadius="18" BorderThickness="1.2" BorderBrush="{TemplateBinding Highlight}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Раздел страницы: заголовок над карточкой и пояснение под ней. -->
    <Style TargetType="{x:Type local:CardSection}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CardSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,0,2,8">
                            <Border Width="17" Height="17" CornerRadius="8.5" Background="{StaticResource Ink}" Margin="0,0,10,0"
                                    Visibility="{TemplateBinding Number, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Number, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        </StackPanel>
                        <local:Card Padding="0">
                            <ContentPresenter />
                        </local:Card>
                        <TextBlock Text="{TemplateBinding Footer}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Margin="4,8,4,0" Visibility="{TemplateBinding Footer, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка карточки-списка: название с пояснением слева, управление справа. -->
    <Style TargetType="{x:Type local:FormRow}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FormRow}">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="13" />
                            <TextBlock Text="{TemplateBinding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"
                                       Visibility="{TemplateBinding Detail, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:InfoRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InfoRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Title}" Foreground="{StaticResource Muted}" Margin="0,0,12,0" />
                        <ContentPresenter Grid.Column="1" HorizontalAlignment="Right" TextBlock.Foreground="{StaticResource Ink}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Значок на скруглённой подложке. -->
    <Style TargetType="{x:Type local:IconTile}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconTile}">
                    <Border Width="{TemplateBinding Size}" Height="{TemplateBinding Size}"
                            CornerRadius="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=0.28}"
                            Background="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                        <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=0.46}"
                                   Foreground="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Короткое состояние в капсуле. -->
    <Style TargetType="{x:Type local:StatusPill}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusPill}">
                    <Border CornerRadius="9" Padding="8,3"
                            Background="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="0,1,4,0"
                                       VerticalAlignment="Center" Visibility="{TemplateBinding Glyph, Converter={StaticResource Visible}}"
                                       Foreground="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}}" />
                            <TextBlock Text="{TemplateBinding Text}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Сообщение со значком и оговорками. -->
    <Style TargetType="{x:Type local:NoticeView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NoticeView}">
                    <Border CornerRadius="10" Padding="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{TemplateBinding Accent}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{TemplateBinding Text}" Style="{DynamicResource SelectableText}" />
                                <ItemsControl ItemsSource="{TemplateBinding Details}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Mode=OneWay}" Style="{DynamicResource SelectableText}" Foreground="{StaticResource Muted}"
                                                     FontSize="12" Margin="0,4,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Шкала стойкости пароля. -->
    <Style TargetType="{x:Type local:PasswordStrengthView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PasswordStrengthView}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{TemplateBinding Segments}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="34" Height="5" CornerRadius="2.5" Background="{Binding}" Margin="0,0,3,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{TemplateBinding Summary}" Foreground="{TemplateBinding Accent}" FontSize="11.5" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{TemplateBinding Advice}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Лист: значок и заголовок сверху, содержимое, кнопки внизу справа под чертой. -->
    <Style TargetType="{x:Type local:SheetWindow}">
        <Setter Property="Background" Value="#F4F4F7" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SheetWindow}">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="24,14">
                                <ContentPresenter Content="{TemplateBinding Actions}" HorizontalAlignment="Right" />
                            </Border>
                            <StackPanel Margin="24,24,24,24">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:IconTile Glyph="{TemplateBinding Glyph}" Tone="{TemplateBinding Tone}" Size="40" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                        <TextBlock Text="{TemplateBinding Heading}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{TemplateBinding Subtitle}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{TemplateBinding Subtitle, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
